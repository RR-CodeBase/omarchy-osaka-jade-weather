// Osaka Jade Weather -- Omarchy menu rows.
//
// Paste these keys into your ~/.config/omarchy/extensions/omarchy-menu.jsonc,
// inside the existing top-level object -- markers included. The file
// hot-reloads on save.
//
// Keep the two marker comments: `install.sh --uninstall` uses them to take
// exactly these rows back out again without touching anything else you have
// added to that file.
//
// The ids are namespaced so they never collide with Omarchy's own weather
// forecast rows, and `checked` reads the live state file, so the tick marks
// are always the truth rather than a cached guess.
{
  // >>> osaka-jade-weather >>>
  "osaka-weather": {
    "icon": "󰖐",
    "label": "Osaka Jade Weather",
    "aliases": [
      "weather",
      "osaka",
      "rain",
      "mood"
    ],
    "description": "Animated wallpaper weather for Osaka Jade Custom"
  },
  "osaka-weather.rain": {
    "icon": "󰖗",
    "label": "Rain",
    "description": "Rain, mist, splashes and distant lightning",
    "action": "osaka-weather rain",
    "checked": "test \"$(osaka-weather status --json | jq -r .rain)\" = true"
  },
  "osaka-weather.day": {
    "icon": "󰖙",
    "label": "Sunshine",
    "description": "Warm light, god rays and drifting dust",
    "action": "osaka-weather day",
    "checked": "test \"$(osaka-weather status --json | jq -r .day)\" = true"
  },
  "osaka-weather.night": {
    "icon": "󰖔",
    "label": "Night",
    "description": "Stars, moonlight and fireflies",
    "action": "osaka-weather night",
    "checked": "test \"$(osaka-weather status --json | jq -r .night)\" = true"
  },
  "osaka-weather.clear": {
    "icon": "󰅖",
    "label": "Clear",
    "description": "All moods off, still-life wallpaper",
    "action": "osaka-weather clear"
  },
  "osaka-weather.storm": {
    "icon": "󰙾",
    "label": "Storm",
    "description": "Heavy rain at night, high wind",
    "action": "osaka-weather storm"
  },
  "osaka-weather.goldenhour": {
    "icon": "󰖚",
    "label": "Golden Hour",
    "description": "Sun and stars at once",
    "action": "osaka-weather goldenhour"
  },
  "osaka-weather.sync": {
    "icon": "󰖝",
    "label": "Match Real Weather",
    "description": "Set the mood from what it is actually doing outside",
    "action": "osaka-weather sync"
  },
  "osaka-weather.auto": {
    "icon": "󰃰",
    "label": "Follow The Sun",
    "description": "Day or night from the local sunrise and sunset",
    "action": "osaka-weather auto"
  }
  // <<< osaka-jade-weather <<<
}
